# Alternative to .env — only needed if you'd rather keep the key in this
# TOML format. Copy this file to "secrets.toml" in this same .streamlit/
# folder and paste your real key in. Never commit the real "secrets.toml"
# file — it's already in .gitignore.
#
# Get a free NVIDIA NIM API key at https://build.nvidia.com
# (open any Nemotron model page -> "Get API Key")

NEMOTRON_API_KEY = "your-nvidia-nim-api-key-here"
